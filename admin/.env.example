NODE_PATH=./src
REACT_APP_API_URL=http://localhost:4000/api/v1
REACT_APP_WS_URL=http://localhost:4000
# avoids a false "Plugin react was conflicted" overlay when the project path casing differs (Forky vs FORKY)
DISABLE_ESLINT_PLUGIN=true

# --- security (see docs/security-frontend.md) ---
# Extra origins the Content-Security-Policy <meta> in public/index.html must allow. Space separated.
# connect-src: API origin + websocket origin (+ the dev server's own websocket for hot reload; remove in production)
REACT_APP_CSP_CONNECT=http://localhost:4000 ws://localhost:4000 ws://localhost:3000 https://api.stripe.com https://m.stripe.network https://r.stripe.com
# img-src / media-src: the API origin (uploads) and any image CDN
REACT_APP_CSP_IMG=http://localhost:4000 https://images.forky.ca https://*.stripe.com
# --- Stripe (the ONE deliberate CSP exception: the Stripe Payment Element needs Stripe.js and Stripe's iframes) ---
# script-src: Stripe.js is loaded from js.stripe.com. frame-src: the card form + 3-D Secure frames. Add Stripe's connect / img origins to the two variables above.
# Required connect-src additions: https://api.stripe.com https://m.stripe.network https://r.stripe.com   Required img-src addition: https://*.stripe.com
REACT_APP_CSP_SCRIPT=https://js.stripe.com
REACT_APP_CSP_FRAME=https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com
# never embed the webpack runtime chunk as an inline <script> (would need 'unsafe-inline' in script-src)
INLINE_RUNTIME_CHUNK=false
# never ship source maps to browsers in production builds
GENERATE_SOURCEMAP=false
# idle auto-logout in minutes (0 disables). Admin console / restaurant portal.
REACT_APP_IDLE_MINUTES_ADMIN=30
REACT_APP_IDLE_MINUTES_PORTAL=480
# idle auto-logout in minutes for the customer website (/order). 0 disables.
REACT_APP_IDLE_MINUTES_STOREFRONT=30
