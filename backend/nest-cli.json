{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "dtoFileNameSuffix": [".dto.ts", "dto.ts", ".controller.ts", ".controllers.ts", ".module.ts", "campaigns.ts", "referrals.ts"],
          "controllerFileNameSuffix": [".controller.ts", ".controllers.ts", ".module.ts"]
        }
      }
    ]
  }
}
