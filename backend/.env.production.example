# =====================================================================================================
# FORKY API - PRODUCTION settings.   cp backend/.env.production.example backend/.env.production   then fill in EVERY value.
# Used by docker-compose.yml (env_file). Never commit the real file (it is git-ignored). Full guide: docs/deployment.md
#
# The API REFUSES TO START unless this is all true: JWT_SECRET random >= 32 chars, DATA_ENCRYPTION_KEY >= 32 chars, DB_SYNC and
# EXPOSE_OTP not true, CORS_ORIGINS / PUBLIC_URL explicit https, ENFORCE_2FA=true, DB_PASSWORD not a well-known default, Stripe LIVE
# keys configured (here or in Admin > System > Integrations), no demo accounts / default admin password, and no pending migrations.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================================================
NODE_ENV=production
PORT=4000

# Public https URL of the API, and of the customer website / admin console (must match deploy/.env APP_DOMAIN / API_DOMAIN)
PUBLIC_URL=https://api.example.ca
WEB_URL=https://app.example.ca
# Exact browser origins allowed to call the API (no wildcards, https only)
CORS_ORIGINS=https://app.example.ca
# Reverse proxies in front of the API. The bundled Caddy is ONE hop. 2 behind Cloudflare + Caddy.
TRUST_PROXY=1

# PostgreSQL. DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME are injected by docker-compose.yml from deploy/.env.
# Set them here only if you run the API against a managed database instead of the bundled "db" container (then also DB_SSL=true).
DB_SSL=false
# The schema is created by migrations (node dist/database/migrate, run by the "migrate" compose service). Never DB_SYNC=true here.
DB_SYNC=false
# Alternative to the migrate step: apply pending migrations when the API connects. Leave false when you run several API instances.
DB_MIGRATIONS_RUN=false

# Auth (REQUIRED)
JWT_SECRET=
DATA_ENCRYPTION_KEY=
ENFORCE_2FA=true
EXPOSE_OTP=false

# First Super Admin, created ONCE by:  docker compose run --rm --no-deps api node dist/database/seed
# Use a strong unique password (the known demo passwords are refused). After the first login you can delete the two SEED_ lines.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Foundation data (cities, zones, tax classes, commission tiers, cuisines, settings) is always seeded; demo restaurants / drivers /
# customers are NOT. The API refuses to start in production while demo accounts exist.
SEED_DEMO=false

# Uploads live on the two docker volumes (uploads = public images, private-uploads = proof-of-delivery photos). Back them up.
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

# Integrations. Normally pasted by a Super Admin under Admin > System > Integrations (stored ENCRYPTED in the database).
# A value saved there WINS over these. Production needs Stripe LIVE keys (sk_live_ / pk_live_) and the webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MAPBOX_ACCESS_TOKEN=
MAPBOX_PUBLIC_TOKEN=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@example.ca
CERTN_API_KEY=
CERTN_WEBHOOK_SECRET=
# Native push (optional): FCM HTTP v1 service-account JSON on one line. Browser push needs nothing (VAPID keys are generated on first boot).
FCM_SERVICE_ACCOUNT_JSON=

# NEVER set these in production (the API refuses to start): ALLOW_MOCK_PAYMENTS, STRIPE_API_BASE, MAPBOX_API_BASE, EXPOSE_OTP=true, DB_SYNC=true
