NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=forksy
DB_SSL=false
# true = tables auto-created from entities (dev). Use migrations in production.
DB_SYNC=true
DB_LOGGING=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ENFORCE_2FA=false
EXPOSE_OTP=true

# Seed
SEED_SUPERADMIN_EMAIL=admin@forksy.ca
SEED_SUPERADMIN_PASSWORD=Admin@12345
SEED_DEMO=true

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

# Integrations (leave blank to use built-in mock adapters)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@forksy.ca
FCM_SERVER_KEY=
CERTN_API_KEY=
