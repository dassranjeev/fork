# =====================================================================================================
# FORKY backend configuration.  Copy to .env.   See docs/SECURITY.md for the production checklist.
#
# NODE_ENV=production REFUSES TO START unless: JWT_SECRET is random and >= 32 chars, DB_SYNC and EXPOSE_OTP are
# not true, CORS_ORIGINS are explicit https origins, PUBLIC_URL is https, Stripe live keys are set, ENFORCE_2FA=true,
# no demo accounts / default admin password exist, and DB_PASSWORD is not a well-known default.
# =====================================================================================================
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
# The FORKY customer website. The ordering assistant sends visitors to ${WEB_URL}/order/handoff?token=... to finish checkout.
WEB_URL=http://localhost:3000
# Exact browser origins allowed to call the API (no wildcards). https only in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of reverse proxies in front of the app (X-Forwarded-For hops that are trusted). 0 = none: the header is IGNORED
# (cannot be spoofed). 1 behind one load balancer / nginx, 2 behind Cloudflare + a load balancer.
TRUST_PROXY=0

# PostgreSQL (production: dedicated least-privilege user, TLS, strong password)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=forky
DB_SSL=false
# true = tables auto-created from entities (dev ONLY). Production must use migrations (the app refuses DB_SYNC=true).
DB_SYNC=true
# Production: apply pending migrations when the API connects (otherwise run: node dist/database/migrate). See docs/deployment.md.
# DB_MIGRATIONS_RUN=false
DB_LOGGING=false
DB_POOL_MAX=20
# Hard per-statement cap (ms) enforced by PostgreSQL itself
DB_STATEMENT_TIMEOUT_MS=15000

# Auth.  Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Mandatory in production (staff + restaurant owners must use TOTP)
ENFORCE_2FA=false
# Dev only: returns one-time codes in API responses. Hard-disabled when NODE_ENV=production.
EXPOSE_OTP=true
# MAX_FAILED_LOGINS=5      # per identifier, then progressive lockout (LOCK_MINUTES doubles on every repeat)
# LOCK_MINUTES=15

# Swagger UI (/docs, /docs-json). Default: on in development, OFF in production.
# SWAGGER_ENABLED=false
# Reject request fields that are not declared in the DTO (400) instead of silently stripping them.
# VALIDATION_FORBID_UNKNOWN=true

# Request limits
# BODY_LIMIT_JSON=100kb
# BODY_LIMIT_JSON_LARGE=2mb        # only POST /restaurant/menu/csv
# SOCKET_MAX_BUFFER_BYTES=16384
# SOCKET_MAX_PER_IP=30
# SOCKET_MAX_PER_USER=8
# MAX_CONNECTIONS=2000
# MAX_CAMPAIGN_RECIPIENTS=50000

# Seed (dev/demo only - the app refuses to start in production while demo accounts or the default admin password exist)
SEED_SUPERADMIN_EMAIL=admin@forky.ca
SEED_SUPERADMIN_PASSWORD=Admin@12345
SEED_DEMO=true

# Uploads (production: replace with a private object store + signed URLs)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

# Ordering assistant (bot). Works without any key (deterministic engine). OPTIONAL and UNTESTED: when set, an LlmBrain adapter is
# consulted first and falls back to the deterministic engine whenever it returns nothing. See docs/assistant.md.
ANTHROPIC_API_KEY=

# Integrations.  Keys are normally pasted by a Super Admin under Admin > System > Integrations (stored ENCRYPTED in the database, never shown again).
# The variables below are the fallback: a value saved in the Integrations page WINS over the environment.
#  - STRIPE_*: every payment goes through Stripe on-page payments. Without a key payments are REFUSED (503), except for the development mock below.
#  - CERTN_*:  without a key the mock background check auto-clears drivers in development and is refused in production
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Register /api/v1/webhooks/stripe in the Stripe dashboard (the Integrations page shows the exact URL and the events to subscribe to).
# Local development with the Stripe CLI:  stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe   (prints the whsec_... to use here)
# DEVELOPMENT / AUTOMATED TESTS ONLY: pretend payments succeed when NO Stripe key is configured. Loud at boot, amber "TEST payment" notice on the
# storefront. Never used when a Stripe key exists. The API REFUSES TO START in production while this is set.
ALLOW_MOCK_PAYMENTS=true
# Fake Stripe / Mapbox servers for the automated tests (backend/test/fakes). Ignored in production (and the boot gate refuses to start with them set).
# STRIPE_API_BASE=http://localhost:4242
# MAPBOX_API_BASE=http://localhost:4243
# Mapbox address search (server side token; Integrations page overrides). sk. token with the Search scope recommended.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PUBLIC_TOKEN=
# Encrypts integration secrets and TOTP seeds at rest (AES-256-GCM). REQUIRED in production, 32+ random chars, keep it apart from JWT_SECRET.
# DATA_ENCRYPTION_KEY=
# Google / Apple client ids accepted for social sign-in (aud check). Required for social sign-in in production.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@forky.ca
# Browser push (W3C Web Push) needs no paid service. VAPID keys are generated ONCE on first boot and stored encrypted in the
# settings table; set these only to pin / share keys between instances. Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@forky.ca
# Production: extra push-service hostnames accepted for browser subscriptions (the major ones are built in)
# PUSH_ENDPOINT_HOSTS=
# Native apps (future): FCM HTTP v1 service-account JSON (one line) or set it in Settings > Notifications. Legacy FCM_SERVER_KEY is no longer used.
FCM_SERVICE_ACCOUNT_JSON=
# Test overrides (never in production): FCM_API_BASE=http://localhost:9999  FCM_TOKEN_URI=http://localhost:9999/token  PUSH_RETRY_BASE_MS=400
CERTN_API_KEY=
# Shared secret Certn must send (X-Webhook-Secret header, or HMAC-SHA256 hex of the raw body in X-Certn-Signature)
CERTN_WEBHOOK_SECRET=
